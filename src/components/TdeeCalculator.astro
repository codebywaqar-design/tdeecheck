---
interface Props {
  prefix?: string;
  emphasis?: 'all' | 'loss';
  presetSex?: 'female' | 'male';
  presetUnits?: 'imperial' | 'metric';
  presetAge?: number;
  presetFt?: number;
  presetIn?: number;
  presetCm?: number;
  presetWeight?: number;
  presetActivity?: string;
  lockActivity?: boolean;
  activityNote?: string;
}

const {
  prefix = 'tdee',
  emphasis = 'all',
  presetSex = 'female',
  presetUnits = 'imperial',
  presetAge = 32,
  presetFt = 5,
  presetIn = 6,
  presetCm = 168,
  presetWeight = 165,
  presetActivity = '1.55',
  lockActivity = false,
  activityNote,
} = Astro.props;
const p = prefix;
const unitsBtn = (u: string) =>
  `${p}-units-btn px-3 py-1.5 rounded-md text-sm font-bold ` + (presetUnits === u ? 'bg-brand-600 text-white' : 'text-ink-700');
const sexBtn = (s: string) =>
  `${p}-sex-btn rounded-lg border px-3 py-2.5 font-bold text-sm ` +
  (presetSex === s ? 'border-brand-600 bg-brand-50 text-brand-800' : 'border-brand-100 bg-white text-ink-700');
---

<div class="bg-white rounded-2xl shadow-lg shadow-brand-900/5 border border-brand-100 p-5 sm:p-7" id="calculator">
  <form id={`${p}-form`} novalidate>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="font-extrabold text-ink-900 text-lg">Your details</p>
      <div class="inline-flex rounded-lg bg-brand-50 border border-brand-100 p-1" role="group" aria-label="Units">
        <button type="button" data-units="imperial" class={unitsBtn('imperial')}>Imperial (lb, ft)</button>
        <button type="button" data-units="metric" class={unitsBtn('metric')}>Metric (kg, cm)</button>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 mt-5">
      <div>
        <span class="block text-sm font-bold text-ink-700 mb-2" id={`${p}-sex-label`}>Sex</span>
        <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-labelledby={`${p}-sex-label`}>
          <button type="button" data-sex="female" class={sexBtn('female')} aria-checked={presetSex === 'female' ? 'true' : 'false'} role="radio">Female</button>
          <button type="button" data-sex="male" class={sexBtn('male')} aria-checked={presetSex === 'male' ? 'true' : 'false'} role="radio">Male</button>
        </div>
      </div>
      <div>
        <label class="block text-sm font-bold text-ink-700 mb-2" for={`${p}-age`}>Age (years)</label>
        <input id={`${p}-age`} type="number" inputmode="numeric" min="10" max="100" value={presetAge} class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <span class="block text-sm font-bold text-ink-700 mb-2">Height</span>
        <div id={`${p}-height-imperial`} class={'grid grid-cols-2 gap-2' + (presetUnits === 'imperial' ? '' : ' hidden')}>
          <label class="sr-only" for={`${p}-ft`}>Feet</label>
          <input id={`${p}-ft`} type="number" inputmode="numeric" min="3" max="8" value={presetFt} placeholder="ft" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
          <label class="sr-only" for={`${p}-inch`}>Inches</label>
          <input id={`${p}-inch`} type="number" inputmode="numeric" min="0" max="11" value={presetIn} placeholder="in" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div id={`${p}-height-metric`} class={presetUnits === 'metric' ? '' : 'hidden'}>
          <label class="sr-only" for={`${p}-cm`}>Centimeters</label>
          <input id={`${p}-cm`} type="number" inputmode="decimal" min="100" max="250" value={presetCm} placeholder="cm" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-bold text-ink-700 mb-2" for={`${p}-weight`}>Weight <span id={`${p}-weight-unit`} class="font-semibold text-ink-500">{presetUnits === 'metric' ? '(kg)' : '(lb)'}</span></label>
        <input id={`${p}-weight`} type="number" inputmode="decimal" min="50" max="1000" value={presetWeight} class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div class="sm:col-span-2">
        <label class="block text-sm font-bold text-ink-700 mb-2" for={`${p}-activity`}>Activity level</label>
        <select id={`${p}-activity`} disabled={lockActivity} class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-brand-50 disabled:text-ink-700">
          <option value="1.2" selected={presetActivity === '1.2'}>Sedentary: desk job, little or no exercise</option>
          <option value="1.375" selected={presetActivity === '1.375'}>Light: exercise 1 to 3 days a week</option>
          <option value="1.55" selected={presetActivity === '1.55'}>Moderate: exercise 3 to 5 days a week</option>
          <option value="1.725" selected={presetActivity === '1.725'}>Very active: hard exercise 6 to 7 days a week</option>
          <option value="1.9" selected={presetActivity === '1.9'}>Athlete: very hard exercise, physical job or training twice a day</option>
        </select>
        {activityNote && <p class="mt-2 text-sm text-ink-500">{activityNote}</p>}
      </div>
      <div class="sm:col-span-2">
        <label class="flex items-start gap-3 cursor-pointer">
          <input id={`${p}-bf-toggle`} type="checkbox" class="mt-1 w-4 h-4 accent-brand-600" />
          <span class="text-sm text-ink-700"><span class="font-bold">I know my body fat percentage</span> (optional, uses the Katch-McArdle formula, best if you have a recent body composition measurement)</span>
        </label>
        <div id={`${p}-bf-wrap`} class="hidden mt-3 max-w-xs">
          <label class="block text-sm font-bold text-ink-700 mb-2" for={`${p}-bf`}>Body fat %</label>
          <input id={`${p}-bf`} type="number" inputmode="decimal" min="3" max="60" placeholder="e.g. 24" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
      </div>
    </div>

    <p id={`${p}-error`} class="hidden mt-4 text-sm font-semibold text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3" role="alert"></p>

    <button type="submit" class="no-print mt-6 w-full sm:w-auto inline-flex justify-center items-center rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-extrabold px-8 py-3.5 text-base shadow-md shadow-brand-600/20">
      Calculate my TDEE
    </button>
  </form>

  <div id={`${p}-results`} class="hidden mt-8 border-t border-brand-100 pt-7" aria-live="polite">
    <div class="rounded-2xl bg-brand-600 text-white p-6 text-center">
      <p class="text-sm font-bold uppercase tracking-wide text-brand-100">Your maintenance calories (TDEE)</p>
      <p class="mt-1 text-5xl font-extrabold"><span id={`${p}-tdee-day`}>0</span> <span class="text-xl font-bold">kcal / day</span></p>
      <p class="mt-2 text-brand-100 font-semibold"><span id={`${p}-tdee-week`}>0</span> kcal per week</p>
      <p id={`${p}-formula-note`} class="mt-3 text-sm text-brand-100"></p>
    </div>

    <h3 class="mt-8 font-extrabold text-ink-900 text-lg">Your calories by goal, with macros</h3>
    <p class="mt-1 text-sm text-ink-500">Macro split in grams per day. Weight loss goals use a higher protein split to protect muscle, maintenance uses a balanced split, and gaining goals shift more energy to carbs.</p>
    <div id={`${p}-goal-cards`} class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div>

    <div class="no-print mt-6 flex flex-wrap gap-3">
      <button type="button" id={`${p}-print`} class="inline-flex items-center rounded-lg border border-brand-200 bg-white px-4 py-2.5 font-bold text-sm text-brand-800 hover:bg-brand-50">Print or save my results</button>
      <a href="/calculators/macro-calculator/" class="inline-flex items-center rounded-lg border border-brand-200 bg-white px-4 py-2.5 font-bold text-sm text-brand-800 hover:bg-brand-50">Fine tune macros with the Macro Calculator</a>
    </div>
    <p class="mt-4 text-xs text-ink-500">These are estimates from population formulas. Your real TDEE can differ by 10 to 15 percent. Track your weight for 2 to 3 weeks and adjust by 100 to 200 kcal if your trend disagrees. See the <a class="underline font-semibold" href="/medical-disclaimer/">medical disclaimer</a>.</p>
  </div>
</div>

<script define:vars={{ p, emphasis, presetSex, presetUnits }}>
  (function () {
    var units = presetUnits;
    var sex = presetSex;
    var form = document.getElementById(p + '-form');

    function $(id) { return document.getElementById(p + '-' + id); }

    function flag(id, bad) {
      var el = $(id);
      if (!el) return;
      el.classList.toggle('ring-2', bad);
      el.classList.toggle('ring-red-400', bad);
    }
    form.querySelectorAll('input').forEach(function (el) {
      el.addEventListener('input', function () { el.classList.remove('ring-2', 'ring-red-400'); });
    });

    function setUnits(u) {
      if (u === units) return;
      units = u;
      document.querySelectorAll('.' + p + '-units-btn').forEach(function (b) {
        var active = b.getAttribute('data-units') === u;
        b.className = b.className.replace(/bg-brand-600 text-white|text-ink-700/g, '').trim();
        b.classList.add.apply(b.classList, active ? ['bg-brand-600', 'text-white'] : ['text-ink-700']);
      });
      $('height-imperial').classList.toggle('hidden', u !== 'imperial');
      $('height-metric').classList.toggle('hidden', u !== 'metric');
      $('weight-unit').textContent = u === 'imperial' ? '(lb)' : '(kg)';
      if (u === 'metric') {
        if ($('ft').value !== '' || $('inch').value !== '') {
          $('cm').value = Math.round(((parseFloat($('ft').value) || 0) * 12 + (parseFloat($('inch').value) || 0)) * 2.54);
        }
      } else {
        var cmVal = parseFloat($('cm').value);
        if (!isNaN(cmVal)) {
          var totalIn = cmVal / 2.54;
          var ftVal = Math.floor(totalIn / 12);
          var inVal = Math.round(totalIn - ftVal * 12);
          if (inVal === 12) { ftVal += 1; inVal = 0; }
          $('ft').value = ftVal;
          $('inch').value = inVal;
        }
      }
      var w = parseFloat($('weight').value);
      if (!isNaN(w)) {
        $('weight').value = u === 'imperial' ? Math.round(w * 2.20462) : Math.round(w / 2.20462);
      }
    }

    function setSex(s) {
      sex = s;
      document.querySelectorAll('.' + p + '-sex-btn').forEach(function (b) {
        var active = b.getAttribute('data-sex') === s;
        b.setAttribute('aria-checked', active ? 'true' : 'false');
        b.className = p + '-sex-btn rounded-lg border px-3 py-2.5 font-bold text-sm ' + (active ? 'border-brand-600 bg-brand-50 text-brand-800' : 'border-brand-100 bg-white text-ink-700');
      });
    }

    document.querySelectorAll('.' + p + '-units-btn').forEach(function (b) {
      b.addEventListener('click', function () { setUnits(b.getAttribute('data-units')); });
    });
    document.querySelectorAll('.' + p + '-sex-btn').forEach(function (b) {
      b.addEventListener('click', function () { setSex(b.getAttribute('data-sex')); });
    });
    $('bf-toggle').addEventListener('change', function () {
      $('bf-wrap').classList.toggle('hidden', !this.checked);
    });
    $('print').addEventListener('click', function () { window.print(); });

    function fmt(n) { return Math.round(n).toLocaleString('en-US'); }

    function macroSplit(cal, kind) {
      var split = kind === 'loss' ? [40, 30, 30] : kind === 'gain' ? [30, 45, 25] : [30, 40, 30];
      return {
        protein: Math.round(cal * split[0] / 100 / 4),
        carbs: Math.round(cal * split[1] / 100 / 4),
        fat: Math.round(cal * split[2] / 100 / 9),
        split: split,
      };
    }

    function weeklyChangeText(deltaPerDay) {
      var lb = deltaPerDay * 7 / 3500;
      if (Math.abs(lb) < 0.05) return 'Weight holds steady';
      var val = units === 'imperial' ? Math.abs(lb).toFixed(1) + ' lb' : (Math.abs(lb) * 0.4536).toFixed(2) + ' kg';
      return (lb < 0 ? 'Lose about ' : 'Gain about ') + val + ' per week';
    }

    function goalCard(goal, tdee) {
      var cal = Math.max(1000, tdee + goal.delta);
      var m = macroSplit(cal, goal.kind);
      var highlight = emphasis === 'loss' && goal.kind === 'loss' && goal.delta === -500;
      var ring = highlight ? ' ring-2 ring-brand-500' : '';
      var badge = highlight ? '<span class="ml-2 align-middle text-xs font-extrabold uppercase tracking-wide bg-brand-600 text-white rounded-full px-2 py-0.5">Your goal</span>' : '';
      var bar = '<div class="flex h-2.5 rounded-full overflow-hidden mt-3" aria-hidden="true">' +
        '<div style="width:' + m.split[0] + '%" class="bg-brand-500"></div>' +
        '<div style="width:' + m.split[1] + '%" class="bg-amber-400"></div>' +
        '<div style="width:' + m.split[2] + '%" class="bg-sky-400"></div></div>';
      return '<article class="rounded-xl border border-brand-100 bg-brand-50/60 p-5' + ring + '">' +
        '<h4 class="font-extrabold text-ink-900">' + goal.label + badge + '</h4>' +
        '<p class="mt-1 text-3xl font-extrabold text-brand-700">' + fmt(cal) + ' <span class="text-sm font-bold text-ink-500">kcal / day</span></p>' +
        '<p class="text-sm font-semibold text-ink-500">' + fmt(cal * 7) + ' kcal per week</p>' +
        '<p class="mt-2 text-sm font-bold text-ink-700">' + weeklyChangeText(cal - tdee) + '</p>' + bar +
        '<ul class="mt-3 text-sm text-ink-700 space-y-1">' +
        '<li><span class="inline-block w-2.5 h-2.5 rounded-full bg-brand-500 mr-2"></span>Protein <strong>' + m.protein + ' g</strong> (' + m.split[0] + '%)</li>' +
        '<li><span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400 mr-2"></span>Carbs <strong>' + m.carbs + ' g</strong> (' + m.split[1] + '%)</li>' +
        '<li><span class="inline-block w-2.5 h-2.5 rounded-full bg-sky-400 mr-2"></span>Fat <strong>' + m.fat + ' g</strong> (' + m.split[2] + '%)</li>' +
        '</ul></article>';
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var err = $('error');
      err.classList.add('hidden');
      var age = parseFloat($('age').value);
      var weightRaw = parseFloat($('weight').value);
      var heightCm;
      if (units === 'imperial') {
        var ft = parseFloat($('ft').value) || 0;
        var inch = parseFloat($('inch').value) || 0;
        heightCm = (ft * 12 + inch) * 2.54;
      } else {
        heightCm = parseFloat($('cm').value);
      }
      var weightKg = units === 'imperial' ? weightRaw * 0.45359237 : weightRaw;
      var activity = parseFloat($('activity').value);
      var bf = $('bf-toggle').checked ? parseFloat($('bf').value) : NaN;

      var ageBad = isNaN(age) || age < 10 || age > 100;
      var weightBad = isNaN(weightRaw) || weightKg < 25 || weightKg > 450;
      var heightBad = isNaN(heightCm) || heightCm < 100 || heightCm > 250;
      flag('age', ageBad);
      flag('weight', weightBad);
      if (units === 'imperial') { flag('ft', heightBad); flag('inch', heightBad); } else { flag('cm', heightBad); }
      if (ageBad || weightBad || heightBad) {
        err.textContent = 'Please enter valid values for the highlighted fields.';
        err.classList.remove('hidden');
        return;
      }
      var bfBad = $('bf-toggle').checked && (isNaN(bf) || bf < 3 || bf > 60);
      flag('bf', bfBad);
      if (bfBad) {
        err.textContent = 'Please enter valid values for the highlighted fields.';
        err.classList.remove('hidden');
        return;
      }

      var bmr, formulaName;
      if (!isNaN(bf)) {
        var lbm = weightKg * (1 - bf / 100);
        bmr = 370 + 21.6 * lbm;
        formulaName = 'Katch-McArdle formula (body fat ' + bf + '%)';
      } else {
        bmr = 10 * weightKg + 6.25 * heightCm - 5 * age + (sex === 'male' ? 5 : -161);
        formulaName = 'Mifflin-St Jeor formula';
      }
      var tdee = bmr * activity;

      $('tdee-day').textContent = fmt(tdee);
      $('tdee-week').textContent = fmt(tdee * 7);
      $('formula-note').textContent = 'Your BMR is ' + fmt(bmr) + ' kcal per day (' + formulaName + '), multiplied by your activity level of ' + activity + '.';

      var goals = [
        { label: 'Mild weight loss', delta: -250, kind: 'loss' },
        { label: 'Weight loss', delta: -500, kind: 'loss' },
        { label: 'Maintenance', delta: 0, kind: 'maintain' },
        { label: 'Mild weight gain', delta: 250, kind: 'gain' },
        { label: 'Weight gain', delta: 500, kind: 'gain' },
      ];
      if (emphasis === 'loss') {
        goals.sort(function (a, b) { return Math.abs(a.delta + 500) - Math.abs(b.delta + 500); });
      }
      $('goal-cards').innerHTML = goals.map(function (g) { return goalCard(g, tdee); }).join('');
      $('results').classList.remove('hidden');
      $('results').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
