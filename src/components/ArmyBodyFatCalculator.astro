---
// US Army body fat calculator: official circumference (tape test) method, inches internally.
// Men: BF% = 86.010 x log10(waist - neck) - 70.041 x log10(height) + 36.76
// Women: BF% = 163.205 x log10(waist + hip - neck) - 97.684 x log10(height) - 78.387
---

<div class="bg-white rounded-2xl shadow-lg shadow-brand-900/5 border border-brand-100 p-5 sm:p-7" id="calculator">
  <form id="army-form" novalidate>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="font-extrabold text-ink-900 text-lg">Your measurements</p>
      <div class="inline-flex rounded-lg bg-brand-50 border border-brand-100 p-1" role="group" aria-label="Units">
        <button type="button" data-units="imperial" class="army-units-btn px-3 py-1.5 rounded-md text-sm font-bold bg-brand-600 text-white">Imperial (in)</button>
        <button type="button" data-units="metric" class="army-units-btn px-3 py-1.5 rounded-md text-sm font-bold text-ink-700">Metric (cm)</button>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4 mt-5">
      <div>
        <span class="block text-sm font-bold text-ink-700 mb-2">Sex</span>
        <div class="grid grid-cols-2 gap-2">
          <button type="button" data-sex="female" class="army-sex-btn rounded-lg border px-3 py-2.5 font-bold text-sm border-brand-100 bg-white text-ink-700">Female</button>
          <button type="button" data-sex="male" class="army-sex-btn rounded-lg border px-3 py-2.5 font-bold text-sm border-brand-600 bg-brand-50 text-brand-800">Male</button>
        </div>
      </div>
      <div>
        <label class="block text-sm font-bold text-ink-700 mb-2" for="army-age">Age group</label>
        <select id="army-age" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="17-20">17 to 20 years</option>
          <option value="21-27" selected>21 to 27 years</option>
          <option value="28-39">28 to 39 years</option>
          <option value="40+">40 years and over</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-bold text-ink-700 mb-2" for="army-height">Height <span class="army-unit font-semibold text-ink-500">(in)</span></label>
        <input id="army-height" type="number" inputmode="decimal" min="40" max="250" step="0.1" value="70" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <label class="block text-sm font-bold text-ink-700 mb-2" for="army-neck">Neck <span class="army-unit font-semibold text-ink-500">(in)</span></label>
        <input id="army-neck" type="number" inputmode="decimal" min="5" max="100" step="0.1" value="15" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
        <p class="mt-1.5 text-xs text-ink-500">Measured just below the Adam's apple, tape level.</p>
      </div>
      <div>
        <label class="block text-sm font-bold text-ink-700 mb-2" for="army-waist">Waist at navel <span class="army-unit font-semibold text-ink-500">(in)</span></label>
        <input id="army-waist" type="number" inputmode="decimal" min="10" max="200" step="0.1" value="34" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
        <p class="mt-1.5 text-xs text-ink-500">Around the belly button, stomach relaxed, not sucked in.</p>
      </div>
      <div id="army-hip-wrap" class="hidden">
        <label class="block text-sm font-bold text-ink-700 mb-2" for="army-hip">Hip <span class="army-unit font-semibold text-ink-500">(in)</span></label>
        <input id="army-hip" type="number" inputmode="decimal" min="10" max="200" step="0.1" value="40" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
        <p class="mt-1.5 text-xs text-ink-500">Around the widest point of the hips and glutes. Women only.</p>
      </div>
    </div>
    <p id="army-error" class="hidden mt-4 text-sm font-semibold text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3" role="alert"></p>
    <button type="submit" class="mt-6 w-full sm:w-auto inline-flex justify-center items-center rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-extrabold px-8 py-3.5 text-base shadow-md shadow-brand-600/20">Calculate my body fat</button>
  </form>

  <div id="army-results" class="hidden mt-8 border-t border-brand-100 pt-7" aria-live="polite">
    <div class="rounded-2xl bg-brand-600 text-white p-6 text-center">
      <p class="text-sm font-bold uppercase tracking-wide text-brand-100">Your body fat (Army tape test)</p>
      <p class="mt-1 text-5xl font-extrabold"><span id="army-bf">0</span><span class="text-xl font-bold"> %</span></p>
      <p id="army-verdict" class="mt-3 text-sm text-brand-100"></p>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-brand-100 bg-brand-50/60 p-5 text-center">
        <p class="text-sm font-bold text-ink-500 uppercase tracking-wide">Army maximum for your group</p>
        <p class="mt-1 text-2xl font-extrabold text-brand-700"><span id="army-standard">0</span> %</p>
      </div>
      <div class="rounded-xl border border-brand-100 bg-brand-50/60 p-5 text-center">
        <p class="text-sm font-bold text-ink-500 uppercase tracking-wide">Margin</p>
        <p class="mt-1 text-2xl font-extrabold text-brand-700" id="army-margin">-</p>
      </div>
    </div>
    <p id="army-fail-note" class="hidden mt-4 text-sm font-semibold text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3"></p>
    <p class="mt-4 text-sm text-ink-700">The Army rounds tape measurements to the nearest half inch and repeats the measurement set before recording a result, so a self measurement can differ slightly from an official one.</p>
  </div>
</div>

<script>
  (function () {
    var units = 'imperial';
    var sex = 'male';
    function $(id) { return document.getElementById(id); }
    function flag(id, bad) {
      var el = $(id);
      if (!el) return;
      el.classList.toggle('ring-2', bad);
      el.classList.toggle('ring-red-400', bad);
    }
    document.querySelectorAll('#army-form input').forEach(function (el) {
      el.addEventListener('input', function () { el.classList.remove('ring-2', 'ring-red-400'); });
    });

    var standards = {
      male: { '17-20': 20, '21-27': 22, '28-39': 24, '40+': 26 },
      female: { '17-20': 30, '21-27': 32, '28-39': 34, '40+': 36 },
    };
    var fields = ['army-height', 'army-neck', 'army-waist', 'army-hip'];

    document.querySelectorAll('.army-units-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        var next = b.getAttribute('data-units');
        if (next === units) return;
        units = next;
        document.querySelectorAll('.army-units-btn').forEach(function (x) {
          var active = x.getAttribute('data-units') === units;
          x.className = 'army-units-btn px-3 py-1.5 rounded-md text-sm font-bold ' + (active ? 'bg-brand-600 text-white' : 'text-ink-700');
        });
        document.querySelectorAll('.army-unit').forEach(function (s) {
          s.textContent = units === 'imperial' ? '(in)' : '(cm)';
        });
        fields.forEach(function (id) {
          var v = parseFloat($(id).value);
          if (!isNaN(v)) $(id).value = units === 'imperial' ? (v / 2.54).toFixed(1) : (v * 2.54).toFixed(1);
        });
      });
    });
    document.querySelectorAll('.army-sex-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        sex = b.getAttribute('data-sex');
        document.querySelectorAll('.army-sex-btn').forEach(function (x) {
          var active = x.getAttribute('data-sex') === sex;
          x.className = 'army-sex-btn rounded-lg border px-3 py-2.5 font-bold text-sm ' + (active ? 'border-brand-600 bg-brand-50 text-brand-800' : 'border-brand-100 bg-white text-ink-700');
        });
        $('army-hip-wrap').classList.toggle('hidden', sex !== 'female');
      });
    });

    function toInches(v) { return units === 'imperial' ? v : v / 2.54; }

    $('army-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var err = $('army-error');
      err.classList.add('hidden');
      $('army-fail-note').classList.add('hidden');
      var height = toInches(parseFloat($('army-height').value));
      var neck = toInches(parseFloat($('army-neck').value));
      var waist = toInches(parseFloat($('army-waist').value));
      var hip = toInches(parseFloat($('army-hip').value));
      var heightBad = isNaN(height) || height < 48 || height > 84;
      var neckBad = isNaN(neck) || neck < 8 || neck > 30;
      var waistBad = isNaN(waist) || waist < 18 || waist > 80;
      flag('army-height', heightBad);
      flag('army-neck', neckBad);
      flag('army-waist', waistBad);
      if (heightBad || neckBad || waistBad) {
        err.textContent = 'Please enter valid values for the highlighted fields.';
        err.classList.remove('hidden');
        return;
      }
      var bf;
      if (sex === 'male') {
        if (waist - neck < 1) {
          err.textContent = 'For men, the waist measurement must be larger than the neck measurement. Check both numbers and measure the waist at the navel.';
          err.classList.remove('hidden');
          return;
        }
        bf = 86.010 * Math.log10(waist - neck) - 70.041 * Math.log10(height) + 36.76;
      } else {
        var hipBad = isNaN(hip) || hip < 20 || hip > 80;
        flag('army-hip', hipBad);
        if (hipBad) {
          err.textContent = 'Please enter valid values for the highlighted fields.';
          err.classList.remove('hidden');
          return;
        }
        if (waist + hip - neck < 1) {
          err.textContent = 'For women, please add a realistic hip measurement, taken at the widest point of the hips.';
          err.classList.remove('hidden');
          return;
        }
        bf = 163.205 * Math.log10(waist + hip - neck) - 97.684 * Math.log10(height) - 78.387;
      }
      if (bf < 2 || bf > 60) {
        err.textContent = 'That combination gives an unrealistic body fat result. Recheck your measurements, especially the waist at the navel.';
        err.classList.remove('hidden');
        return;
      }
      var ageGroup = $('army-age').value;
      var standard = standards[sex][ageGroup];
      var diff = standard - bf;
      $('army-bf').textContent = bf.toFixed(1);
      $('army-standard').textContent = standard;
      if (diff >= 0) {
        $('army-verdict').textContent = 'You meet the US Army body composition standard for the ' + ageGroup + ' age group.';
        $('army-margin').textContent = diff.toFixed(1) + ' points under';
      } else {
        $('army-verdict').textContent = 'This is above the US Army maximum for the ' + ageGroup + ' age group.';
        $('army-margin').textContent = Math.abs(diff).toFixed(1) + ' points over';
        var note = $('army-fail-note');
        note.textContent = 'Above standard by ' + Math.abs(diff).toFixed(1) + ' percentage points. In service this result would normally trigger enrollment in the Army Body Composition Program, with nutrition counseling and regular re-measurement.';
        note.classList.remove('hidden');
      }
      $('army-results').classList.remove('hidden');
      $('army-results').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
