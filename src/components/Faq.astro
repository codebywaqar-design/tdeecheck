---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  faqs: FaqItem[];
  title?: string;
}

const { faqs, title = 'Frequently asked questions' } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="mt-12" aria-label="Frequently asked questions">
  <h2 class="text-2xl font-extrabold text-ink-900">{title}</h2>
  <div class="mt-5 space-y-3">
    {faqs.map((f) => (
      <details class="faq bg-white border border-brand-100 rounded-xl px-5 py-4 shadow-sm">
        <summary class="flex items-center justify-between gap-4 font-bold text-ink-900">
          <span>{f.q}</span>
          <svg class="faq-chevron w-5 h-5 shrink-0 text-brand-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        </summary>
        <p class="mt-3 text-ink-700 leading-relaxed">{f.a}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
