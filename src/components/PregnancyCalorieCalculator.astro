---
// Pregnancy calorie calculator: Mifflin-St Jeor TDEE (female) plus trimester additions.
// Trimester 1: +0, trimester 2: +340, trimester 3: +450 kcal per day.
---

<div class="bg-white rounded-2xl shadow-lg shadow-brand-900/5 border border-brand-100 p-5 sm:p-7" id="calculator">
  <form id="preg-form" novalidate>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="font-extrabold text-ink-900 text-lg">Your details</p>
      <div class="inline-flex rounded-lg bg-brand-50 border border-brand-100 p-1" role="group" aria-label="Units">
        <button type="button" data-units="imperial" class="preg-units-btn px-3 py-1.5 rounded-md text-sm font-bold bg-brand-600 text-white">Imperial (lb, ft)</button>
        <button type="button" data-units="metric" class="preg-units-btn px-3 py-1.5 rounded-md text-sm font-bold text-ink-700">Metric (kg, cm)</button>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4 mt-5">
      <div>
        <label class="block text-sm font-bold text-ink-700 mb-2" for="preg-age">Age (years)</label>
        <input id="preg-age" type="number" inputmode="numeric" min="15" max="55" value="30" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <label class="block text-sm font-bold text-ink-700 mb-2" for="preg-trimester">Trimester</label>
        <select id="preg-trimester" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="0">First trimester (weeks 1 to 13), +0 kcal</option>
          <option value="340" selected>Second trimester (weeks 14 to 27), +340 kcal</option>
          <option value="450">Third trimester (weeks 28 to birth), +450 kcal</option>
        </select>
      </div>
      <div>
        <span class="block text-sm font-bold text-ink-700 mb-2">Height</span>
        <div id="preg-height-imperial" class="grid grid-cols-2 gap-2">
          <input id="preg-ft" type="number" inputmode="numeric" min="3" max="8" value="5" placeholder="ft" aria-label="Feet" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
          <input id="preg-inch" type="number" inputmode="numeric" min="0" max="11" value="5" placeholder="in" aria-label="Inches" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div id="preg-height-metric" class="hidden">
          <input id="preg-cm" type="number" inputmode="numeric" min="100" max="250" value="165" placeholder="cm" aria-label="Centimeters" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-bold text-ink-700 mb-2" for="preg-weight">Current weight <span id="preg-weight-unit" class="font-semibold text-ink-500">(lb)</span></label>
        <input id="preg-weight" type="number" inputmode="decimal" min="50" max="1000" value="150" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div class="sm:col-span-2">
        <label class="block text-sm font-bold text-ink-700 mb-2" for="preg-activity">Activity level</label>
        <select id="preg-activity" class="w-full rounded-lg border border-brand-100 px-3 py-2.5 font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="1.2">Sedentary: desk job, little or no exercise</option>
          <option value="1.375" selected>Light: exercise 1 to 3 days a week</option>
          <option value="1.55">Moderate: exercise 3 to 5 days a week</option>
          <option value="1.725">Very active: hard exercise 6 to 7 days a week</option>
          <option value="1.9">Athlete: very hard exercise, physical job or training twice a day</option>
        </select>
        <p class="mt-1.5 text-xs text-ink-500">Pick the level that matches your life now, not before pregnancy. Many women drop a level in the first and third trimesters.</p>
      </div>
    </div>
    <p id="preg-error" class="hidden mt-4 text-sm font-semibold text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3" role="alert"></p>
    <button type="submit" class="mt-6 w-full sm:w-auto inline-flex justify-center items-center rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-extrabold px-8 py-3.5 text-base shadow-md shadow-brand-600/20">Calculate my pregnancy calories</button>
  </form>

  <div id="preg-results" class="hidden mt-8 border-t border-brand-100 pt-7" aria-live="polite">
    <div class="rounded-2xl bg-brand-600 text-white p-6 text-center">
      <p class="text-sm font-bold uppercase tracking-wide text-brand-100">Your pregnancy calorie target</p>
      <p class="mt-1 text-5xl font-extrabold"><span id="preg-target">0</span> <span class="text-xl font-bold">kcal / day</span></p>
      <p id="preg-breakdown" class="mt-3 text-sm text-brand-100"></p>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-brand-100 bg-brand-50/60 p-5 text-center">
        <p class="text-sm font-bold text-ink-500 uppercase tracking-wide">Your maintenance (TDEE)</p>
        <p class="mt-1 text-2xl font-extrabold text-brand-700"><span id="preg-tdee">0</span> kcal</p>
      </div>
      <div class="rounded-xl border border-brand-100 bg-brand-50/60 p-5 text-center">
        <p class="text-sm font-bold text-ink-500 uppercase tracking-wide">Pregnancy addition</p>
        <p class="mt-1 text-2xl font-extrabold text-brand-700">+<span id="preg-add">0</span> kcal</p>
      </div>
    </div>
    <p class="mt-4 rounded-xl bg-amber-50 border border-amber-200 px-5 py-4 text-sm font-semibold text-ink-700">
      Please confirm this target with your doctor or midwife. Pregnancy needs vary with your starting weight, whether
      you are carrying twins, and your medical history, and only your own care team can set your personal target.
    </p>
  </div>
</div>

<script>
  (function () {
    var units = 'imperial';
    function $(id) { return document.getElementById(id); }
    function fmt(n) { return Math.round(n).toLocaleString('en-US'); }

    document.querySelectorAll('.preg-units-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        units = b.getAttribute('data-units');
        document.querySelectorAll('.preg-units-btn').forEach(function (x) {
          var active = x.getAttribute('data-units') === units;
          x.className = 'preg-units-btn px-3 py-1.5 rounded-md text-sm font-bold ' + (active ? 'bg-brand-600 text-white' : 'text-ink-700');
        });
        $('preg-height-imperial').classList.toggle('hidden', units !== 'imperial');
        $('preg-height-metric').classList.toggle('hidden', units !== 'metric');
        $('preg-weight-unit').textContent = units === 'imperial' ? '(lb)' : '(kg)';
        var w = parseFloat($('preg-weight').value);
        if (!isNaN(w)) $('preg-weight').value = units === 'imperial' ? Math.round(w * 2.20462) : Math.round(w / 2.20462);
      });
    });

    $('preg-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var err = $('preg-error');
      err.classList.add('hidden');
      var age = parseFloat($('preg-age').value);
      var weightRaw = parseFloat($('preg-weight').value);
      var heightCm = units === 'imperial'
        ? ((parseFloat($('preg-ft').value) || 0) * 12 + (parseFloat($('preg-inch').value) || 0)) * 2.54
        : parseFloat($('preg-cm').value);
      var weightKg = units === 'imperial' ? weightRaw * 0.45359237 : weightRaw;
      var activity = parseFloat($('preg-activity').value);
      var addition = parseFloat($('preg-trimester').value);
      if (isNaN(age) || age < 15 || age > 55 || isNaN(weightRaw) || weightKg < 30 || weightKg > 450 || isNaN(heightCm) || heightCm < 100 || heightCm > 250) {
        err.textContent = 'Please check your entries: age 15 to 55, a realistic height, and a realistic weight.';
        err.classList.remove('hidden');
        return;
      }
      var bmr = 10 * weightKg + 6.25 * heightCm - 5 * age - 161;
      var tdee = bmr * activity;
      var target = tdee + addition;
      $('preg-target').textContent = fmt(target);
      $('preg-tdee').textContent = fmt(tdee);
      $('preg-add').textContent = fmt(addition);
      $('preg-breakdown').textContent = 'Maintenance of ' + fmt(tdee) + ' kcal (BMR ' + fmt(bmr) + ' x activity ' + activity + ') plus ' + fmt(addition) + ' kcal for this trimester.';
      $('preg-results').classList.remove('hidden');
      $('preg-results').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
