---
import BaseLayout from '../../layouts/BaseLayout.astro';

const groups = [
  {
    title: 'Calculators',
    links: [
      { href: '/', name: 'TDEE Calculator' },
      { href: '/calculators/', name: 'All Calculators' },
      { href: '/calculators/bmr-calculator/', name: 'BMR Calculator' },
      { href: '/calculators/calorie-calculator/', name: 'Calorie Calculator' },
      { href: '/calculators/macro-calculator/', name: 'Macro Calculator' },
      { href: '/calculators/bmi-calculator/', name: 'BMI Calculator' },
      { href: '/calculators/calorie-deficit-calculator/', name: 'Calorie Deficit Calculator' },
      { href: '/calculators/water-intake-calculator/', name: 'Water Intake Calculator' },
      { href: '/calculators/ffmi-calculator/', name: 'FFMI Calculator' },
      { href: '/calculators/army-body-fat-calculator/', name: 'Army Body Fat Calculator' },
      { href: '/calculators/lean-body-mass-calculator/', name: 'Lean Body Mass Calculator' },
      { href: '/calculators/pregnancy-calorie-calculator/', name: 'Pregnancy Calorie Calculator' },
      { href: '/calculators/breastfeeding-calorie-calculator/', name: 'Breastfeeding Calorie Calculator' },
      { href: '/tdee-weight-loss-calculator/', name: 'TDEE Weight Loss Calculator' },
      { href: '/tdee-calculator-for-women/', name: 'TDEE Calculator for Women' },
      { href: '/tdee-calculator-for-men/', name: 'TDEE Calculator for Men' },
      { href: '/tdee-calculator-kg/', name: 'TDEE Calculator (kg and cm)' },
      { href: '/sedentary-tdee-calculator/', name: 'Sedentary TDEE Calculator' },
    ],
  },
  {
    title: 'Guides',
    links: [
      { href: '/blog/', name: 'Blog' },
      { href: '/blog/how-to-calculate-tdee/', name: 'How to Calculate Your TDEE, Step by Step' },
      { href: '/blog/tdee-vs-bmr/', name: 'TDEE vs BMR: What Is the Difference?' },
      { href: '/blog/how-accurate-are-tdee-calculators/', name: 'How Accurate Are TDEE Calculators?' },
      { href: '/blog/what-is-a-calorie-deficit/', name: 'What Is a Calorie Deficit?' },
    ],
  },
  {
    title: 'About and policies',
    links: [
      { href: '/about/', name: 'About TDEE Check' },
      { href: '/contact/', name: 'Contact' },
      { href: '/editorial-policy/', name: 'Editorial Policy' },
      { href: '/medical-disclaimer/', name: 'Medical Disclaimer' },
      { href: '/privacy-policy/', name: 'Privacy Policy' },
      { href: '/cookie-policy/', name: 'Cookie Policy' },
      { href: '/terms/', name: 'Terms of Use' },
      { href: '/dmca/', name: 'DMCA and Copyright Policy' },
    ],
  },
];
---

<BaseLayout
  title="Sitemap - All Pages on TDEE Check"
  description="Every page on TDEE Check in one list: all calculators, guides, and policy pages."
  path="/sitemap/"
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Sitemap', path: '/sitemap/' },
  ]}
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-10">
    <h1 class="text-4xl font-extrabold tracking-tight text-ink-900">Sitemap</h1>
    <p class="mt-4 text-ink-700 leading-relaxed">Every page on TDEE Check, grouped by section.</p>
    {groups.map((g) => (
      <div>
        <h2 class="mt-10 text-2xl font-extrabold text-ink-900">{g.title}</h2>
        <ul class="mt-3 space-y-2 text-ink-700 leading-relaxed list-disc pl-6">
          {g.links.map((l) => (
            <li><a class="font-bold text-brand-700 underline" href={l.href}>{l.name}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>
