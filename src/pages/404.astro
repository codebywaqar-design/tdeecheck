---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found - TDEE Check"
  description="That page does not exist. Head back to the free TDEE calculator or browse all of our calorie and nutrition calculators."
  path="/404/"
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-16 pb-8 text-center">
    <p class="text-6xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-extrabold text-ink-900">This page burned off</h1>
    <p class="mt-3 text-ink-700 leading-relaxed">
      The page you were looking for does not exist. The good news: your calories are still easy to find.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-extrabold px-6 py-3">Open the TDEE Calculator</a>
      <a href="/calculators/" class="inline-flex rounded-xl border border-brand-200 bg-white font-extrabold px-6 py-3 text-brand-800 hover:bg-brand-50">Browse all calculators</a>
    </div>
  </section>
</BaseLayout>
