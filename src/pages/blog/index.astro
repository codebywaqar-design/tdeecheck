---
import BaseLayout from '../../layouts/BaseLayout.astro';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'TDEE Check blog guides',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'How to Calculate Your TDEE, Step by Step',
        url: 'https://tdeecheck.com/blog/how-to-calculate-tdee/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'TDEE vs BMR: What Is the Difference and Which Do You Need?',
        url: 'https://tdeecheck.com/blog/tdee-vs-bmr/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'How Accurate Are TDEE Calculators?',
        url: 'https://tdeecheck.com/blog/how-accurate-are-tdee-calculators/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'What Is a Calorie Deficit? Sizes, Safety and a Worked Example',
        url: 'https://tdeecheck.com/blog/what-is-a-calorie-deficit/',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'What Is a Good TDEE? Average TDEE by Age, Sex and Activity',
        url: 'https://tdeecheck.com/blog/average-tdee/',
      },
      {
        '@type': 'ListItem',
        position: 6,
        name: 'How to Use TDEE for Weight Loss: The Safe Deficit Guide',
        url: 'https://tdeecheck.com/blog/tdee-for-weight-loss/',
      },
      {
        '@type': 'ListItem',
        position: 7,
        name: 'Why Your TDEE Changed: 7 Reasons Your Number Moves',
        url: 'https://tdeecheck.com/blog/why-your-tdee-changed/',
      },
      {
        '@type': 'ListItem',
        position: 8,
        name: 'TDEE for Beginners: The Complete Plain-Language Guide',
        url: 'https://tdeecheck.com/blog/tdee-for-beginners/',
      },
      {
        '@type': 'ListItem',
        position: 9,
        name: 'Eating Below Your BMR: Is It Safe?',
        url: 'https://tdeecheck.com/blog/eating-below-your-bmr/',
      },
      {
        '@type': 'ListItem',
        position: 10,
        name: 'How Activity Levels Really Work (and Why Most People Overestimate)',
        url: 'https://tdeecheck.com/blog/how-activity-levels-work/',
      },
      {
        '@type': 'ListItem',
        position: 11,
        name: 'Reverse Dieting Explained: Raising Calories After a Diet',
        url: 'https://tdeecheck.com/blog/reverse-dieting-explained/',
      },
      {
        '@type': 'ListItem',
        position: 12,
        name: 'TDEE Calculator vs MyFitnessPal: Which Should You Use?',
        url: 'https://tdeecheck.com/blog/tdee-calculator-vs-myfitnesspal/',
      },
    ],
  },
];
---

<BaseLayout
  title="Blog - TDEE, Calories and Nutrition Guides | TDEE Check"
  description="Practical guides from TDEE Check: how to calculate TDEE, use your numbers, and plan calories and macros. Reviewed by Farah Akram, Dietitian."
  path="/blog/"
  schemas={schemas}
  ogType="article"
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
  ]}
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-8">
    <h1 class="text-4xl font-extrabold tracking-tight text-ink-900">Blog</h1>
    <p class="mt-4 text-lg text-ink-700 leading-relaxed max-w-3xl">
      Straightforward guides on calories, TDEE, and macros, written in plain language and reviewed by a dietitian.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/blog/how-to-calculate-tdee/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/how-to-calculate-tdee-hero.webp" alt="Illustration of a woman using a calorie calculator app" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">How to Calculate Your TDEE, Step by Step</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">The full Mifflin-St Jeor method with worked examples for a woman and a man, plus how to check and adjust your result.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/tdee-vs-bmr/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/tdee-vs-bmr-hero.webp" alt="Illustration contrasting BMR and TDEE, resting energy on one side and an active day on the other" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">TDEE vs BMR: What Is the Difference?</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">BMR is your resting burn, TDEE is your whole day. The difference, one worked example, and which number sets your calorie target.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/how-accurate-are-tdee-calculators/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/tdee-accuracy-hero.webp" alt="Illustration of a TDEE calculator estimate being checked against real world results" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">How Accurate Are TDEE Calculators?</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">Why calculators land within about 10 percent for most people, where the error hides, and the 2 to 3 week test that finds your real number.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/what-is-a-calorie-deficit/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/calorie-deficit-guide-hero.webp" alt="Illustration of a calorie deficit, a balanced plate beside daily energy burn icons" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">What Is a Calorie Deficit?</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">What a calorie deficit is, the four common sizes compared, the honest truth about the 3,500 kcal rule, and a worked example from a real TDEE.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/average-tdee/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/average-tdee-hero.webp" alt="Illustration of people of different ages, sizes and activity levels, each with their own daily calorie burn" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">What Is a Good TDEE?</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">There is no single good TDEE. Typical ranges by sex and activity, how age moves your number, and why your own tested figure beats any average.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/tdee-for-weight-loss/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/tdee-weight-loss-guide-hero.webp" alt="Illustration of a calorie target set just below daily energy burn for weight loss" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">TDEE for Weight Loss</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">Find your maintenance, take a safe 250 to 500 kcal deficit, set protein first, and handle plateaus without crashing below the safe floors.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/why-your-tdee-changed/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/why-tdee-changed-hero.webp" alt="Illustration of the same person at different weights, ages and activity levels with different daily calorie burns" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">Why Your TDEE Changed</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">Weight change, muscle, drifting steps, aging, dieting itself, sleep and plain water weight: the 7 reasons your number moves, and what to do about each.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/tdee-for-beginners/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/tdee-beginners-hero.webp" alt="Illustration of a beginner learning how daily calorie burn works, with simple energy icons" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">TDEE for Beginners</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">Zero jargon: what TDEE and BMR mean in plain words, one worked example, a tiny glossary, and the three things to do in your first week.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/eating-below-your-bmr/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/eating-below-bmr-hero.webp" alt="Illustration of the body's resting energy needs, the organs and systems that BMR pays for" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">Eating Below Your BMR: Is It Safe?</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">What your BMR pays for, why eating under it backfires, who must never try it, and how to set a deficit from TDEE instead.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/how-activity-levels-work/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/activity-levels-hero.webp" alt="Illustration of five activity levels from a desk worker to an athlete, with rising daily step counts" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">How Activity Levels Really Work</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">The five multipliers in real jobs and step counts, why a desk job plus gym still lands at light or moderate, and a step-count self-test.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/reverse-dieting-explained/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/reverse-dieting-hero.webp" alt="Illustration of calories being added back gradually after a diet, plates growing step by step toward maintenance" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">Reverse Dieting Explained</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">Adding calories back after a diet: 50 to 150 kcal a week, what the scale does at first, how long it takes, and when to skip it entirely.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
      <a href="/blog/tdee-calculator-vs-myfitnesspal/" class="block bg-white border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition">
        <img src="/images/tdee-vs-myfitnesspal-hero.webp" alt="Illustration comparing a TDEE calculator that sets a calorie target with a food logging app that tracks meals" width="2048" height="1152" class="w-full aspect-video object-cover" loading="lazy" />
        <span class="block p-6 pt-4">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-1">Guide</span>
        <h2 class="mt-3 font-extrabold text-ink-900 text-lg">TDEE Calculator vs MyFitnessPal</h2>
        <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">One tool sets your calorie number and shows its math, the other tracks what you eat. Why their numbers differ, and the workflow that uses both well.</p>
        <span class="mt-3 inline-block text-sm font-bold text-brand-700">Read the guide</span>
        </span>
      </a>
    </div>
    <p class="mt-10 text-ink-700 max-w-3xl leading-relaxed">
      The guide library now covers the whole TDEE journey, from your first calculation to raising calories again
      after a diet. More guides are on the way, including how protein targets are set and how to eat for muscle
      gain. Until then, the fastest route to your number is the
      <a class="font-bold text-brand-700 underline" href="/">TDEE Calculator</a> itself.
    </p>
  </section>
</BaseLayout>
